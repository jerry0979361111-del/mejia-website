{
  // Cloudflare 部署設定（Workers 靜態資產，即新版 Cloudflare Pages）。
  // 網站本身是純靜態，不需要 Astro 的 cloudflare adapter；只有 /api/* 會進 worker/index.ts。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mejia-website",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-26",
  // 正式網域 mejia.au（www.mejia.au 由 worker-www/ 另一個小 Worker 轉到 mejia.au）；workers.dev 與預覽網址保留給測試
  "routes": [{ "pattern": "mejia.au", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "mejia-leads", "database_id": "88921100-3069-4547-8a16-aa11fee46ea4" }
  ],
  // 非機密設定。金鑰用 `npx wrangler secret put <名稱>`：TURNSTILE_SECRET、RESEND_API_KEY、LINE_CHANNEL_TOKEN
  "vars": {
    "NOTIFY_EMAIL": "jerry0979361111@gmail.com,admin@mejia.au",
    "MAIL_FROM": "Mejia 美家官網 <noreply@mejia.au>", // mejia.au 已由 Resend 自動設定 DNS（2026-11-18）
    "MAIL_FALLBACK_TO": "jerry0979361111@gmail.com", // MAIL_FROM 寄送失敗時改用 Resend 測試寄件人寄到這裡（須是 Resend 註冊信箱）
    "LINE_TO": ""
  },
  "observability": { "enabled": true }
}
