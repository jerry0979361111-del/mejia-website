{
  // Cloudflare 部署設定（Workers 靜態資產，即新版 Cloudflare Pages）。
  // 網站是純靜態，不需要 Astro 的 cloudflare adapter。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mejia-website",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
