{
  // Cloudflare 部署設定（Workers 靜態資產，即新版 Cloudflare Pages）。
  // 網站本身是純靜態，不需要 Astro 的 cloudflare adapter；只有 /api/* 會進 worker/index.ts。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mejia-website",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "mejia-leads", "database_id": "88921100-3069-4547-8a16-aa11fee46ea4" }
  ],
  // 非機密設定。金鑰用 `npx wrangler secret put <名稱>`：TURNSTILE_SECRET、RESEND_API_KEY、LINE_CHANNEL_TOKEN
  "vars": {
    "NOTIFY_EMAIL": "jerry0979361111@gmail.com",
    "MAIL_FROM": "",
    "LINE_TO": ""
  },
  "observability": { "enabled": true }
}
