---
// 所有頁面共用的外框：<head>、頁首、頁尾、AI 顧問浮動視窗與提示訊息。
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AiChat from '../components/AiChat.astro';
import { site } from '../data/site';
import { cityList } from '../data/cities';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title = `${site.name}｜${site.tagline}`,
  description = `台灣、澳洲二地團隊，專注${cityList}新建案買賣、貸款法務與交屋後租賃管理。`,
  image = '/img/prop-ripley-square-north-terraces.jpg',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-Hant-TW">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  {site.noindex && <meta name="robots" content="noindex, nofollow">}
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/favicon.png">
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL(image, Astro.site)}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700&family=Noto+Serif+TC:wght@400;600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <AiChat />
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    import { $$, toast } from '../scripts/ui';
    import { initFavs } from '../scripts/favorites';

    initFavs();

    // 尚未完成的子頁面連結：先顯示提示，不跳頁
    $$<HTMLElement>('[data-demo]').forEach((a) =>
      a.addEventListener('click', (e) => { e.preventDefault(); toast(a.dataset.demo!); }),
    );

    // 捲動時淡入
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }), { threshold: 0.12 });
    $$('.rv').forEach((e) => io.observe(e));
  </script>
</body>
</html>
