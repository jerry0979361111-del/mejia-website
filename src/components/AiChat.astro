---
// 右下角「搜尋・AI 置產顧問」：
//   打字時即時列出站內搜尋結果（瀏覽器端，索引 /search-index.json，由 scripts/build-search-index.mjs 產生）；
//   按送出則交給 /api/chat（worker/chat.ts）用站內內容產生 AI 回答，並附上參考連結。
// 快速問題按鈕仍用 content.ts 的固定答案（免費、即時）。
import { chatAnswers } from '../data/content';
---
<button class="fab" id="fab" aria-controls="chat" aria-expanded="false"><i></i><span>搜尋・問 AI 顧問</span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12a8 8 0 01-11.5 7.2L4 20l1-4.6A8 8 0 1121 12z"/></svg></button>
<div class="chat" id="chat" role="dialog" aria-label="美家站內搜尋與 AI 置產顧問">
  <div class="chat-head">
    <div><b>美家 AI 置產顧問</b><small>搜尋建案、文章，或直接問問題</small></div>
    <button id="chat-x" aria-label="關閉" style="color:#fff;font-size:22px;line-height:1">×</button>
  </div>
  <div class="chat-body" id="cb" aria-live="polite">
    <div class="msg bot">你好，我是美家的 AI 置產顧問。可以直接輸入建案名稱、城市與預算（例如「墨爾本 80 萬以下」），或問我澳洲買房的問題。</div>
  </div>
  <div class="chat-res" id="cr" hidden>
    <div class="chat-res-head"><span id="cr-count">搜尋結果</span><span class="hint">按 Enter 請 AI 整理回答</span></div>
    <ul id="cr-list"></ul>
  </div>
  <div class="quick" id="quick">
    {chatAnswers.map((c) => <button type="button" data-q={c.key}>{c.q}</button>)}
  </div>
  <form class="chat-form" id="cf" autocomplete="off">
    <input id="ci" type="text" maxlength="300" placeholder="輸入關鍵字或問題…" aria-label="搜尋或提問" enterkeyhint="send">
    <button type="submit" id="cs" aria-label="送出"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
  </form>
  <p class="chat-note">AI 回答依網站內容整理，僅供參考；實際條件請以顧問與律師確認為準。</p>
</div>

<script define:vars={{ answers: Object.fromEntries(chatAnswers.map((c) => [c.key, c.a])) }}>
  window.__chatAnswers = answers;
</script>

<script>
  import { search, typeName, type Doc } from '../scripts/search';

  type Source = Partial<Doc> & { title: string; url: string; type: Doc['type']; n?: number };
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const chat = $('chat'), cb = $('cb'), cr = $('cr'), crList = $('cr-list'), quick = $('quick');
  const form = $<HTMLFormElement>('cf'), input = $<HTMLInputElement>('ci'), send = $<HTMLButtonElement>('cs');
  const fab = $<HTMLButtonElement>('fab');
  const answers: Record<string, string> = (window as any).__chatAnswers;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const history: { role: 'user' | 'assistant'; content: string }[] = [];

  // ── 搜尋索引：第一次打開對話框才下載 ──
  let index: Promise<Doc[]> | null = null;
  const loadIndex = () => (index ??= fetch('/search-index.json').then((r) => (r.ok ? r.json() : [])).catch(() => []));

  function openChat(open = !chat.classList.contains('open')) {
    chat.classList.toggle('open', open);
    fab.setAttribute('aria-expanded', String(open));
    fab.querySelector('span')!.textContent = open ? '收起對話' : '搜尋・問 AI 顧問';
    if (open) { loadIndex(); setTimeout(() => input.focus(), 50); }
  }
  fab.addEventListener('click', () => openChat());
  $('chat-x').addEventListener('click', () => openChat(false));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && chat.classList.contains('open')) openChat(false); });

  const scroll = () => { cb.scrollTop = cb.scrollHeight; };
  function addMsg(cls: 'me' | 'bot', html: string) {
    const el = document.createElement('div');
    el.className = `msg ${cls}`;
    el.innerHTML = html;
    cb.append(el);
    scroll();
    return el;
  }

  const meta = (d: Source) => d.type === 'project' ? [d.loc, d.price].filter(Boolean).join(' · ') : (d.desc ?? '');
  const card = (d: Source) => `
    <li><a href="${esc(d.url)}" class="chat-card">
      ${d.img ? `<span class="th"><img src="${esc(d.img)}" alt="" loading="lazy"></span>` : `<span class="th ph">${esc(typeName[d.type])}</span>`}
      <span class="tx"><span class="tag">${d.n ? `［${d.n}］` : ''}${esc(typeName[d.type])}</span><b>${esc(d.title)}</b><span class="meta">${esc(meta(d))}</span></span>
    </a></li>`;

  // ── 打字時即時搜尋 ──
  let timer = 0;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(async () => {
      const q = input.value.trim();
      if (!q) { cr.hidden = true; quick.hidden = false; return; }
      const docs = await loadIndex();
      if (input.value.trim() !== q) return;
      const hits = search(docs, q, 6);
      quick.hidden = true;
      cr.hidden = false;
      $('cr-count').textContent = hits.length ? `搜尋結果 ${hits.length} 筆` : '找不到相符的內容';
      crList.innerHTML = hits.map(card).join('');
    }, 120);
  });

  // ── 送出：請 AI 用站內內容回答 ──
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const q = input.value.trim();
    if (!q || send.disabled) return;
    input.value = '';
    cr.hidden = true;
    quick.hidden = true;
    addMsg('me', esc(q));
    const bot = addMsg('bot', '<span class="typing"><i></i><i></i><i></i></span>');
    send.disabled = true;
    const w = window as any;
    (w.dataLayer = w.dataLayer || []).push({ event: 'site_search', search_term: q });
    w.gtag?.('event', 'search', { search_term: q });

    let out: { ok?: boolean; answer?: string | null; reason?: string; sources?: Source[] } = {};
    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ q, history, page: location.pathname }),
      });
      out = await res.json();
    } catch {}

    let sources = out.sources ?? [];
    if (!out.ok) {
      // 後端失敗時至少給站內搜尋結果
      const docs = await loadIndex();
      sources = search(docs, q, 5);
      out.reason = 'error';
    }
    const note = out.answer ? '' : out.reason === 'limit'
      ? '今天的 AI 提問次數已達上限，以下是站內搜尋結果：'
      : sources.length ? 'AI 暫時無法回答，以下是網站上的相關內容：' : '找不到相關內容，換個關鍵字試試，或留下聯絡方式請顧問回覆。';
    const project = sources.find((s) => s.type === 'project');
    bot.innerHTML = `
      ${out.answer ? `<div class="ans">${esc(out.answer)}</div>` : `<div class="ans">${esc(note)}</div>`}
      ${sources.length ? `<ul class="chat-src">${sources.map(card).join('')}</ul>` : ''}
      <div class="chat-cta">${project ? `<a href="${esc(project.url)}#contact">索取 ${esc(project.title)} 樓書</a>` : ''}<a href="#" data-human>找真人顧問</a></div>`;
    if (out.answer) {
      history.push({ role: 'user', content: q }, { role: 'assistant', content: out.answer });
      history.splice(0, Math.max(0, history.length - 6));
    }
    send.disabled = false;
    scroll();
    input.focus();
  });

  // 「找真人顧問」：捲到頁面上的聯絡表單
  function toContact() {
    openChat(false);
    const contact = document.getElementById('contact');
    if (contact) contact.scrollIntoView({ behavior: 'smooth' }); else location.href = '/contact/';
  }
  cb.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('[data-human]');
    if (a) { e.preventDefault(); toContact(); }
  });

  // ── 快速問題（固定答案）──
  quick.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
    addMsg('me', esc(b.textContent ?? ''));
    const bot = addMsg('bot', '<span class="typing"><i></i><i></i><i></i></span>');
    setTimeout(() => {
      bot.innerHTML = `<div class="ans">${esc(answers[b.dataset.q!])}</div>`;
      scroll();
      if (b.dataset.q === 'human') setTimeout(toContact, 1600);
    }, 500);
  }));
</script>
